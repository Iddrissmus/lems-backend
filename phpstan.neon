includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Read the array returned by Model::casts() so enum and date casts are typed.
    parseModelCastsMethod: true
    # Sanctum documents currentAccessToken() as PersonalAccessToken but it can be
    # a TransientToken (e.g. Sanctum::actingAs), so our instanceof checks are real.
    treatPhpDocTypesAsCertain: false
    paths:
        - app
        - routes
        - database
    # Raise the level step by step as the codebase grows.
