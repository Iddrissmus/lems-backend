    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Current user (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Roles, permissions and must_change_password. Works even while a password change is pending."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/password/change",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "password",
                "change"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password\",\n  \"password\": \"A-new-Passw0rd-2026\",\n  \"password_confirmation\": \"A-new-Passw0rd-2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs the current password. Clears must_change_password. Signs out other devices."
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the current token. 204 with no body."
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/password/forgot",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "password",
                "forgot"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@demo.test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Always 202. With MAIL_MAILER=log the email (and its link) is written to storage/logs/laravel.log."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
