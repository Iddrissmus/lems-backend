              "raw": "{{base_url}}/users/invite",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "invite"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Lecturer\",\n  \"email\": \"new.lecturer@demo.test\",\n  \"roles\": [\n    \"lecturer\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
