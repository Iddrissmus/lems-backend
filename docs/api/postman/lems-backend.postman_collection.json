    {
      "name": "1. Sign in as... (saves the token)",
      "item": [
        {
          "name": "Sign in as super_admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"super_admin@demo.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('signed in', () => pm.response.to.have.status(200));",
                  "if (body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "  pm.collectionVariables.set('my_id', body.data.user.id);",
                  "  console.log('roles:', body.data.user.roles.join(', '), '| must_change_password:', body.data.user.must_change_password);",
                  "}"
                ]
              }
            }
          ]
        },
